@@ -0,0 +1,82 @@
+begin;
+
+create table if not exists public.homepage_slides (
+    id bigint generated by default as identity primary key,
+    enabled boolean not null default true,
+    sort_order integer not null default 0,
+    title_el text not null default '',
+    title_de text not null default '',
+    description_el text not null default '',
+    description_de text not null default '',
+    alt_el text not null default '',
+    alt_de text not null default '',
+    image_480 text not null default '',
+    image_960 text not null default '',
+    image_1920 text not null default '',
+    image_fallback text not null default '',
+    created_at timestamptz not null default now(),
+    updated_at timestamptz not null default now()
+);
+
+create index if not exists homepage_slides_enabled_order_idx
+    on public.homepage_slides(enabled, sort_order, id);
+
+insert into public.homepage_slides (
+    enabled,
+    sort_order,
+    title_el,
+    title_de,
+    description_el,
+    description_de,
+    alt_el,
+    alt_de,
+    image_480,
+    image_960,
+    image_1920,
+    image_fallback
+)
+select
+    true,
+    10,
+    'Καλώς ήρθατε στην ιστοσελίδα μας!',
+    'Willkommen auf unserer Webseite!',
+    'Σύλλογος ομογενών Ελλήνων Rothrist',
+    'Griechischer Verein der Auswanderer von Rothrist',
+    'Ελληνικός Σύλλογος Hellas στο Rothrist',
+    'Griechischer Verein Hellas in Rothrist',
+    '/uploads/img-69cd9f9a21-480.webp',
+    '/uploads/img-69cd9f9a21-960.webp',
+    '/uploads/img-69cd9f9a21-orig.webp',
+    '/uploads/img-69cd9f9a21-orig.jpg'
+where not exists (select 1 from public.homepage_slides);
+
+insert into public.homepage_slides (
+    enabled,
+    sort_order,
+    title_el,
+    title_de,
+    description_el,
+    description_de,
+    alt_el,
+    alt_de,
+    image_480,
+    image_960,
+    image_1920,
+    image_fallback
+)
+select
+    true,
+    20,
+    'Σύλλογος ομογενών του Rothrist',
+    'Verein der Auslandgriechen von Rothrist',
+    'Ιδρυμένος το 2019, ο σύλλογός μας διατηρεί και προωθεί τις ελληνικές παραδόσεις, τη γλώσσα και τον πολιτισμό στην Ελβετία.',
+    'Gegründet 2019 pflegt und fördert unser Verein die griechischen Traditionen, Sprache und Kultur in der Schweiz.',
+    'Δράσεις του Ελληνικού Συλλόγου Hellas',
+    'Aktivitäten des Griechischen Vereins Hellas',
+    '/uploads/img-87c77443a0-480.webp',
+    '/uploads/img-87c77443a0-960.webp',
+    '/uploads/img-87c77443a0-orig.webp',
+    '/uploads/img-87c77443a0-orig.jpg'
+where (select count(*) from public.homepage_slides) = 1;
+
+commit;
